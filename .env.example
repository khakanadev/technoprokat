# Шаблон конфигурации. Скопируйте в .env и замените все значения CHANGE_ME.
# Файл .env содержит секреты и в репозиторий не помещается (.gitignore).

# Пароль владельца БД (миграции, резервное копирование)
DB_OWNER_PASSWORD=CHANGE_ME_owner_password
# Пароль учётной записи приложения technoprokat_app (минимальные права)
APP_DB_PASSWORD=CHANGE_ME_app_password
# Секрет подписи токенов: не короче 32 случайных символов (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_jwt_secret

# Порты на хосте
DB_PORT=55432
API_PORT=3100

# Попыток входа с одного адреса за 5 минут
LOGIN_RATE_MAX=30

# Каталог резервных копий и срок хранения, дней
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=28
# Второй носитель для копий (правило 3-2-1), например /mnt/backup/technoprokat
BACKUP_MIRROR_DIR=
# Файл ключа шифрования копий; хранится отдельно от копий (openssl rand -hex 32 > ~/.technoprokat/backup.key)
BACKUP_KEY_FILE=
